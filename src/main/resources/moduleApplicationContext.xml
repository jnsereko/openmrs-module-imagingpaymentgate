<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <!--
      Core's HibernateSessionFactoryBean chains every org.hibernate.Interceptor bean in the context,
      so this sees every new Obs, including those written straight through Hibernate (FHIR2).
      It has no dependencies on purpose: the session factory depends on it.
    -->
    <bean id="imagingPaymentGateInterceptor"
          class="org.openmrs.module.imagingpaymentgate.ImagingPaymentGateInterceptor"/>
</beans>
